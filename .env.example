# 当前后台仅供本机演示，不接收任何真实模型密钥。
HOST=127.0.0.1
PORT=3000
STORAGE_MODE=memory
AUTH_MODE=demo
# 微信登录需 STORAGE_MODE=postgres 与 AUTH_MODE=wechat，AppSecret 仅写入本机 .env。
# WECHAT_APP_ID=wx0123456789abcdef
# WECHAT_APP_SECRET=
# 启用 PostgreSQL 时改为 postgres，并在本机 .env 中填写数据库连接。
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/roundtable_dev?schema=public

# 个人秘书：off=未接入模型（默认，明确提示不可用）/ stub=本地规则解析，无密钥演示
# http 需要下面三项，密钥只从本机 .env 读取，接口永不接收密钥。
# SECRETARY_MODE=off
# SECRETARY_BASE_URL=https://api.openai.com/v1
# SECRETARY_MODEL=
# SECRETARY_API_KEY=

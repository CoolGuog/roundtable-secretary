[Unit]
Description=Roundtable Secretary API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=roundtable
Group=roundtable
WorkingDirectory=/srv/roundtable/current
EnvironmentFile=/etc/roundtable/production.env
ExecStart=/usr/bin/node apps/api/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

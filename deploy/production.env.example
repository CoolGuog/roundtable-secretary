# 复制到服务器 /etc/roundtable/production.env；不要提交填好后的文件。
# 使用 systemd EnvironmentFile 格式，值不写 shell 命令或变量引用。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_API_ORIGIN=https://api.example.com
STORAGE_MODE=postgres
AUTH_MODE=wechat
DATABASE_URL=postgresql://roundtable:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/roundtable?schema=public
WECHAT_APP_ID=REPLACE_WITH_YOUR_APPID
WECHAT_APP_SECRET=REPLACE_WITH_YOUR_APPSECRET
# 首次上线关闭模型；如要启用 http，另按个人秘书文档配置域名、模型白名单与后台密钥。
SECRETARY_MODE=off

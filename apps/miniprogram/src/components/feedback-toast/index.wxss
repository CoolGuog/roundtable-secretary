.overlay { position: fixed; top: 20rpx; left: 28rpx; right: 28rpx; z-index: 9999; pointer-events: none; display: flex; justify-content: center; }
.message { max-width: 100%; box-sizing: border-box; padding: 22rpx 30rpx; border-radius: 20rpx; background: rgba(36, 51, 43, .86); color: #fff; font-size: 27rpx; line-height: 1.6; box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, .12); overflow-wrap: break-word; }
.message { pointer-events: auto; }

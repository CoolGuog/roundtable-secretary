page { background: #f5f4ef; color: #243c32; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 28rpx; }
view, text, button, input, picker { box-sizing: border-box; }
.page { padding: 36rpx 32rpx 60rpx; }
.eyebrow { font-size: 22rpx; letter-spacing: 3rpx; color: #6c796f; }
.title { font-size: 52rpx; line-height: 1.3; font-weight: 600; margin: 12rpx 0 18rpx; }
.subtitle { color: #6a766d; font-size: 27rpx; line-height: 1.8; }
.card { background: #fff; border-radius: 28rpx; padding: 32rpx; margin-top: 28rpx; border: 1rpx solid #e5e8df; }
.card-title { font-size: 32rpx; font-weight: 600; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.muted { color: #758077; font-size: 24rpx; line-height: 1.7; }
.badge { display: inline-block; background: #e8eee7; color: #41634e; padding: 8rpx 16rpx; border-radius: 24rpx; font-size: 22rpx; }
.notice { margin-top: 24rpx; color: #7b7159; background: #eeeade; border-radius: 16rpx; padding: 18rpx 22rpx; font-size: 23rpx; line-height: 1.7; }
.primary { background: #214e3d; color: #fff; border-radius: 18rpx; font-size: 28rpx; line-height: 88rpx; margin-top: 28rpx; }
.secondary { background: #edf1e9; color: #315541; border-radius: 18rpx; font-size: 26rpx; line-height: 80rpx; margin-top: 18rpx; }
button::after { border: 0; }
.field-label { display: block; font-size: 25rpx; margin: 26rpx 0 12rpx; color: #526257; }
.field { background: #f5f6f2; padding: 20rpx; border-radius: 14rpx; min-height: 84rpx; font-size: 28rpx; }
.two-col { display: flex; gap: 20rpx; }
.two-col > view { flex: 1; }
.section-label { margin-top: 36rpx; margin-bottom: 14rpx; font-size: 25rpx; color: #6f7a70; }
.empty { padding: 45rpx 10rpx; color: #758077; text-align: center; line-height: 1.9; }
.error { margin-top: 18rpx; color: #a63b35; line-height: 1.6; font-size: 25rpx; }
.record { padding: 24rpx 0; border-bottom: 1rpx solid #ecede7; }
.record:last-child { border-bottom: 0; }
.record-title { font-size: 29rpx; margin-bottom: 10rpx; }
.link-button { font-size: 24rpx; background: transparent; color: #8d6259; margin: 0; padding: 10rpx; min-width: 90rpx; line-height: 1.6; }
.spaced { margin-top: 20rpx; }

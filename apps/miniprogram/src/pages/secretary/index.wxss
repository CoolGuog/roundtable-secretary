.title { white-space: pre-line; }
.intro { margin-top: 38rpx; }
.intro-text { flex: 1; }
.avatar { width: 112rpx; height: 112rpx; background: #f0f3e8; border-radius: 30rpx; position: relative; flex-shrink: 0; }
.table { position: absolute; width: 48rpx; height: 48rpx; left: 32rpx; top: 32rpx; background: #295840; border-radius: 50%; }
.dot { position: absolute; width: 16rpx; height: 16rpx; background: #89a66f; border-radius: 50%; }
.d1 { top: 9rpx; left: 48rpx; }.d2 { bottom: 9rpx; left: 48rpx; }.d3 { left: 9rpx; top: 48rpx; }.d4 { right: 9rpx; top: 48rpx; }
.saved { margin-top: 28rpx; font-size: 24rpx; color: #667a67; padding: 8rpx 0; }
.steps { display: flex; gap: 14rpx; }
.step { flex: 1; background: #eeeee6; padding: 24rpx 16rpx; border-radius: 18rpx; font-size: 22rpx; color: #92988b; }
.step text { display: block; font-size: 34rpx; margin-bottom: 18rpx; }
.step.active { background: #e3ebdc; color: #36543f; }
.area { height: 132rpx; line-height: 40rpx; padding-top: 16rpx; }
.conversation { margin: 24rpx 0; height: 440rpx; }
.message { padding: 20rpx 24rpx; margin-bottom: 16rpx; border-radius: 18rpx; font-size: 27rpx; line-height: 1.7; background: #f1f3eb; word-break: break-all; }
.message.user { margin-left: 40rpx; background: #e3ebdc; }
.message.secretary { margin-right: 24rpx; }
.speaker { font-size: 22rpx; color: #667a67; margin-bottom: 6rpx; }
.conflict-notice { margin-top: 24rpx; padding: 24rpx; border-radius: 18rpx; background: #fff1d9; color: #775322; font-size: 26rpx; line-height: 1.7; word-break: break-all; }
.conflict-notice .card-title { color: #775322; }
.conflict-item { padding: 18rpx 0; border-bottom: 1rpx solid #e8d4b2; }
.conflict-item text { font-size: 24rpx; }

<feedback-toast message="{{error}}" />
<view class="page compact-calendar">
  <view class="row calendar-header"><view class="card-title">我的日程</view><button class="link-button" bindtap="openWeek">周视图 →</button></view>
  <view class="card calendar-tools">
    <view class="row date-navigation">
      <button class="day-arrow" bindtap="previousDay" disabled="{{selectedDate === '2020-01-01'}}">‹</button>
      <picker mode="date" value="{{selectedDate}}" start="2020-01-01" end="2099-12-31" bindchange="onSelectedDate"><view class="selected-date">{{selectedDate}} ▾</view></picker>
      <button class="day-arrow" bindtap="nextDay" disabled="{{selectedDate === '2099-12-31'}}">›</button>
      <button class="link-button" bindtap="today">今天</button>
    </view>
    <view class="week-strip">
      <button wx:for="{{days}}" wx:key="date" class="day-cell {{selectedDate === item.date ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="onDay" disabled="{{item.date < '2020-01-01' || item.date > '2099-12-31'}}"><text class="weekday">{{item.label}}</text><text>{{item.number}}</text></button>
    </view>
    <view class="calendar-filters categories">
      <button wx:for="{{categories}}" wx:key="value" class="filter-button {{category === item.value ? 'selected' : ''}}" data-category="{{item.value}}" bindtap="onCategory">{{item.label}} {{categoryCounts[item.value]}}</button>
    </view>
    <view class="row list-toolbar"><text class="muted">当天 {{matchingCount}} 条安排</text><view class="record-actions"><button class="link-button" bindtap="toggleTools">{{toolsOpen ? '收起筛选' : '筛选'}}</button><button class="link-button" bindtap="reload" disabled="{{loading || saving || deletingId}}">刷新</button></view></view>
    <view wx:if="{{toolsOpen}}" class="advanced-tools">
      <input class="field calendar-search" value="{{query}}" maxlength="60" placeholder="搜索当天安排名称" bindinput="onSearch" />
      <view class="calendar-filters"><button wx:for="{{filters}}" wx:key="value" class="filter-button {{filter === item.value ? 'selected' : ''}}" data-filter="{{item.value}}" bindtap="onFilter">{{item.label}}</button></view>
      <button wx:if="{{filterActive}}" class="link-button clear-filters" bindtap="clearFilters">清除筛选，回到今天</button>
    </view>
    <view wx:if="{{loading}}" class="empty">正在读取…</view>
    <view wx:elif="{{error && items.length === 0}}" class="empty">读取失败，请点击刷新重试。</view>
    <view wx:elif="{{matchingCount === 0}}" class="empty no-matches">当天没有符合条件的安排</view>
    <block wx:for="{{groups}}" wx:key="date">
      <view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="record row">
        <view class="record-content"><view class="record-title">{{record.title}}</view><view class="muted">{{record.startTime}}—{{record.endTime}} · {{record.stateLabel}}</view><view wx:if="{{record.repeatLabel}}" class="repeat-meta">{{record.repeatLabel}}{{record.repeatUntil ? ' · 截至 ' + record.repeatUntil : ''}}</view></view>
        <view class="record-actions"><button class="link-button" data-id="{{record.id}}" bindtap="openEdit" disabled="{{saving || deletingId || loading}}">编辑</button><button class="link-button" data-id="{{record.id}}" bindtap="remove" disabled="{{saving || deletingId || loading}}">删除</button></view>
      </view>
    </block>
    <button class="secondary" bindtap="add">＋ 添加安排</button>
  </view>
  <view class="card" wx:if="{{editingId}}">
    <view class="card-title">修改这条安排</view>
    <view wx:if="{{editRepeated}}" class="notice">{{editScope === 'future' ? '修改本次及以后；历史保留，后续已单独修改的例外保留。日期不变，星期规则继续生效。' : '仅修改本次，其他重复安排保持不变。'}}</view>
    <text class="field-label">安排名称</text>
    <input class="field calendar-edit-title" value="{{editTitle}}" maxlength="60" placeholder="例如：课程讨论练习" bindinput="onEditTitle" />
    <text class="field-label">日期</text>
    <picker mode="date" value="{{editDate}}" disabled="{{editRepeated && editScope === 'future'}}" start="2020-01-01" end="2099-12-31" bindchange="onEditDate"><view class="field">{{editDate}}</view></picker>
    <view class="two-col">
      <view><text class="field-label">开始</text><picker mode="time" value="{{editStart}}" bindchange="onEditStart"><view class="field">{{editStart}}</view></picker></view>
      <view><text class="field-label">结束</text><picker mode="time" value="{{editEnd}}" bindchange="onEditEnd"><view class="field">{{editEnd}}</view></picker></view>
    </view>
    <view class="muted spaced">按北京时间（UTC+8）记录。不修改的字段会保持原值。</view>
    <view wx:if="{{editRepeated && editScope === 'future'}}"><text class="field-label">重复结束日期</text><picker mode="date" value="{{editUntil || editDate}}" start="{{editDate}}" end="2099-12-31" bindchange="onEditUntil"><view class="field">{{editUntil || '选择结束日期（原规则不限期）'}}</view></picker></view>
    <button class="primary" loading="{{saving}}" disabled="{{saving || deletingId || loading}}" bindtap="submitEdit">保存修改</button>
    <button class="secondary" disabled="{{saving || deletingId}}" bindtap="closeEdit">取消</button>
  </view>

</view>

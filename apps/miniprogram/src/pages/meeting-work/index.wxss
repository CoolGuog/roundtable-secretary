.work-tabs { display: flex; gap: 10rpx; margin: 24rpx 0; }
.work-tab { flex: 1; margin: 0; padding: 0; font-size: 25rpx; line-height: 76rpx; border-radius: 16rpx; background: #e9eee5; color: #355541; }
.work-tab.active { background: #214e3d; color: white; }
.work-text { white-space: pre-wrap; word-break: break-all; line-height: 1.7; }
.work-area { width: 100%; min-height: 150rpx; height: 190rpx; line-height: 1.7; }
.work-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.work-actions button { flex: 1; min-width: 140rpx; font-size: 24rpx; }
.overdue { color: #a63b35; font-size: 24rpx; margin: 12rpx 0; }
.work-summary { margin: 20rpx 0; color: #526257; line-height: 1.8; }
.work-history { margin-top: 18rpx; border-top: 1rpx solid #e1e5dc; padding-top: 16rpx; }

<view class="page">
  <view wx:if="{{loading}}" class="empty">正在读取圆桌…</view>
  <view wx:if="{{toastMessage}}" class="toast-overlay" role="alert"><view class="toast-content">{{toastMessage}}</view></view>
  <button class="secondary refresh-room" bindtap="reload" disabled="{{busy || loading}}">刷新圆桌</button>
  <block wx:if="{{room}}">
    <text class="eyebrow">AROUND THE TABLE</text><view class="title">{{room.title}}</view>
    <text class="badge">{{room.status === 'OPEN' ? '进行中' : '已关闭'}}</text>
    <view class="card"><view class="card-title">活动目标</view><view class="goal spaced">{{room.goal}}</view><view class="subtitle spaced">{{room.dateFrom}} 至 {{room.dateTo}}</view><view class="muted">每天 {{room.startTime}} — {{room.endTime}}（北京时间）<view>活动时长 {{room.durationMinutes}} 分钟</view></view></view>
    <view wx:if="{{room.inviteCode}}" class="card"><view class="card-title">邀请伙伴</view><view class="invite-code">{{room.inviteCode}}</view><view class="muted">{{expiresLabel}} 前有效（北京时间）<view>仅分享给你希望加入的伙伴。</view></view><button class="secondary copy-code" bindtap="copyCode" disabled="{{busy}}">复制邀请码</button><button class="link-button rotate-code" bindtap="rotate" disabled="{{busy}}">更新邀请码</button></view>
    <view class="card"><view class="row"><view class="card-title">圆桌成员</view><text class="badge">{{room.members.length}} / 3 人</text></view>
      <view wx:for="{{room.members}}" wx:key="id" class="record"><view class="row"><view class="member-name">{{item.name}}{{item.isMe ? '（我）' : ''}}<view class="muted">{{item.role === 'OWNER' ? '发起人' : '成员'}} · {{item.shareBusy ? '已授权本次忙闲' : '未授权忙闲'}}</view></view><button wx:if="{{room.isOwner && !item.isMe && room.status === 'OPEN'}}" class="link-button remove-member" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">移除</button></view></view>
    </view>
    <view wx:if="{{room.status === 'OPEN'}}" class="card"><view class="card-title">我的本次授权</view><view class="subtitle spaced">授权范围仅为上述日期与每天时间窗口的忙闲信息，不包含日程标题、原因或个人记忆。可随时撤回。</view><view class="notice">计算共同时间时只读取已授权成员的忙闲区间；全员确认写入前会检查各自日程是否冲突。</view><button class="secondary consent-button" bindtap="consent" disabled="{{busy || loading || finding}}">{{shareBusy ? '撤回本次忙闲授权' : '授权本次忙闲信息'}}</button></view>
    <view wx:if="{{room.status === 'OPEN' && !local}}" class="card">
      <view class="card-title">共同可用时间</view>
      <view class="subtitle spaced">只交换「这个时段忙不忙」，不交换日程标题和原因。未授权成员的安排不参与计算。</view>
      <view class="muted spaced">只推荐当前北京时间之后的空档，已过去的上午或其他时段不参与推荐。</view>
      <button class="secondary find-time" bindtap="findTime" disabled="{{busy || loading || finding}}">{{finding ? '正在计算…' : '计算共同可用时间'}}</button>
      <block wx:if="{{availability}}">
        <view wx:if="{{availability.note}}" class="notice">{{availability.note}}</view>
        <view wx:if="{{availability.reason}}" class="notice">{{availability.reason}}</view>
        <view wx:for="{{availability.slots}}" wx:key="key" wx:for-index="index" class="record">
          <view class="row">
            <view class="slot-text">{{item.date}} {{item.startTime}}–{{item.endTime}}</view>
            <button class="link-button pick-slot" data-index="{{index}}" bindtap="chooseSlot" disabled="{{busy}}">提出</button>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{room.status === 'OPEN' && !local}}" class="card">
      <view class="card-title">手动选时或改期</view>
      <view class="subtitle spaced">可选推荐列表以外的时间。活动时长为 {{room.durationMinutes}} 分钟；选择开始时间后自动填写结束时间。</view>
      <view wx:if="{{manualNotice}}" class="notice">{{manualNotice}}</view>
      <text class="field-label">活动日期（北京时间）</text>
      <picker class="manual-date" mode="date" start="{{room.dateFrom}}" end="{{room.dateTo}}" value="{{manualDate}}" bindchange="onManualDate" disabled="{{busy || loading || finding}}"><view class="field">{{manualDate}}</view></picker>
      <view class="two-col">
        <view><text class="field-label">开始时间</text><picker class="manual-start" mode="time" start="{{room.startTime}}" end="{{room.endTime}}" value="{{manualStart}}" bindchange="onManualStart" disabled="{{busy || loading || finding}}"><view class="field">{{manualStart || '请选择开始时间'}}</view></picker></view>
        <view><text class="field-label">结束时间</text><picker class="manual-end" mode="time" start="{{room.startTime}}" end="{{room.endTime}}" value="{{manualEnd}}" bindchange="onManualEnd" disabled="{{busy || loading || finding}}"><view class="field">{{manualEnd || '请选择结束时间'}}</view></picker></view>
      </view>
      <view class="muted spaced">无需授权即可手动提案。已授权成员的忙闲会在提案时检查，所有成员的日程会在全员确认时检查。</view>
      <view class="notice">手动改期也需要全员重新接受。确认完成前原日程保持不变；全员接受后更新本活动日程。</view>
      <view wx:if="{{proposal.status === 'OPEN' && !proposal.stale}}" class="notice">已有待确认方案，请先完成确认或由提案人撤回。</view>
      <button class="primary manual-propose" bindtap="chooseManual" disabled="{{busy || loading || finding || room.members.length < 2 || (proposal.status === 'OPEN' && !proposal.stale)}}">提出这个时间</button>
    </view>
    <view wx:if="{{proposal}}" class="card">
      <view class="row"><view class="card-title">协商方案</view><text class="badge">{{proposal.status === 'OPEN' ? (proposal.stale ? '已失效' : '待确认') : proposal.status === 'CONFIRMED' ? '已确认' : proposal.status === 'REJECTED' ? '已拒绝' : proposal.status === 'CANCELLED' ? '已撤回' : '已失效'}}</text></view>
      <view class="goal spaced">{{proposal.date}} {{proposal.startTime}}–{{proposal.endTime}}</view>
      <view wx:if="{{proposal.stale}}" class="notice">成员或授权已变化，这个方案已失效，请重新计算后再发起。</view>
      <view wx:if="{{proposal.status === 'CONFIRMED'}}" class="notice">全员接受，已写入各自日程。</view>
      <view wx:if="{{proposal.status === 'REJECTED'}}" class="notice">有人拒绝了这个时间，可以重新计算后再发起。</view>
      <view wx:if="{{proposal.status === 'CANCELLED'}}" class="notice">提案人已撤回，可以重新计算后再发起。</view>
      <view wx:if="{{proposal.status === 'EXPIRED'}}" class="notice">方案已失效，请重新计算后再发起。</view>
      <view wx:for="{{proposal.votes}}" wx:key="key" class="record">
        <view class="row">
          <view class="member-name">{{item.name}}{{item.isMe ? '（我）' : ''}}</view>
          <text class="badge">{{item.decision === 'ACCEPT' ? '已接受' : item.decision === 'REJECT' ? '已拒绝' : '待表态'}}</text>
        </view>
      </view>
      <view wx:if="{{proposal.status === 'OPEN' && !proposal.stale}}" class="row decisions">
        <button class="secondary accept" data-decision="ACCEPT" bindtap="decide" disabled="{{busy || loading || proposal.myDecision === 'ACCEPT'}}">{{proposal.myDecision === 'ACCEPT' ? '已接受' : '接受'}}</button>
        <button class="link-button reject" data-decision="REJECT" bindtap="decide" disabled="{{busy || loading}}">拒绝</button>
      </view>
      <view wx:if="{{proposal.status === 'OPEN' && !proposal.stale && proposal.myDecision === 'ACCEPT'}}" class="notice">你已接受这个时间，正在等待其他成员确认。全员接受前日程保持不变。</view>
      <button wx:if="{{proposal.status === 'OPEN' && proposal.createdByMe}}" class="secondary cancel-proposal" bindtap="cancelProposal" disabled="{{busy || loading}}">撤回方案</button>
    </view>
    <view wx:if="{{local}}" class="notice">本机演示不会邀请其他人，也不会交换信息。</view>
    <button wx:if="{{room.isOwner && room.status === 'OPEN'}}" class="secondary close-room" bindtap="closeRoom" disabled="{{busy || loading}}">关闭圆桌</button>
    <button wx:if="{{!room.isOwner}}" class="secondary leave-room" bindtap="leave" disabled="{{busy || loading}}">退出圆桌</button>
  </block>
</view>

<view class="page"><text class="eyebrow">WORK TOGETHER</text><view class="title">一起准备，记录与落实。</view>
  <view class="notice">发起人分派给圆桌成员，负责人本人提交完成说明。提交时的全体成员各自确认后才完成；异议与操作历史保留。此处使用后台记录，本机工作台记录不会自动上传。</view>
  <view wx:if="{{!enabled}}" class="error">需要后台模式和本人登录后使用。</view>
  <button wx:if="{{enabled}}" class="secondary refresh-shared" bindtap="reload" disabled="{{busy || loading}}">{{loading ? '读取中…' : '刷新伙伴进展'}}</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{view}}">
    <view class="muted spaced">停留页面时约每 15 秒读取；编辑期间暂停自动刷新。</view>
    <view class="work-tabs"><button class="secondary tab-preparation" data-tab="preparation" bindtap="switchTab" disabled="{{busy || editor}}">会前清单{{tab === 'preparation' ? ' ·' : ''}}</button><button class="secondary tab-minutes" data-tab="minutes" bindtap="switchTab" disabled="{{busy || editor}}">会议纪要{{tab === 'minutes' ? ' ·' : ''}}</button><button class="secondary tab-tasks" data-tab="tasks" bindtap="switchTab" disabled="{{busy || editor}}">协作任务{{tab === 'tasks' ? ' ·' : ''}}</button></view>
    <button wx:if="{{tab === 'tasks' && view.canManage && !editor}}" class="primary new-shared" bindtap="edit" disabled="{{busy || !fresh}}">分派新任务</button>
    <button wx:if="{{tab === 'preparation' && view.canManage && !editor}}" class="primary new-preparation" bindtap="editPreparation" disabled="{{busy || !fresh}}">新增准备事项</button>
    <button wx:if="{{tab === 'minutes' && view.canManage && !editor}}" class="primary new-minutes" bindtap="editMinutes" disabled="{{busy || !fresh}}">{{view.minutes.length ? '修订纪要（保留旧版）' : '记录会议纪要'}}</button>
    <view wx:if="{{editor}}" class="card">
      <block wx:if="{{editor === 'task' || editor === 'preparation' || editor === 'import'}}"><view class="card-title">{{editor === 'import' ? '后续行动转入任务 · 确认预览' : editor === 'preparation' ? '会前准备事项' : taskId ? '修改／重新分派' : '新任务'}}</view><view class="field-label">名称</view><input class="field shared-title" value="{{title}}" maxlength="60" data-field="title" bindinput="field" disabled="{{busy || editor === 'import'}}" />
        <view class="field-label">负责人</view><picker class="shared-assignee" range="{{view.participants}}" range-key="name" value="{{assigneeIndex}}" bindchange="assignee" disabled="{{busy}}"><view class="field">{{view.participants[assigneeIndex].name}} ▾</view></picker>
        <view class="field-label">截止日期</view><picker mode="date" value="{{dueDate}}" start="2000-01-01" end="2099-12-31" data-field="dueDate" bindchange="field" disabled="{{busy}}"><view class="field">{{dueDate}} ▾</view></picker>
        <view class="field-label">说明</view><textarea class="field work-area shared-details" value="{{details}}" maxlength="500" data-field="details" bindinput="field" disabled="{{busy || editor === 'import'}}" />
        <view wx:if="{{editor === 'preparation'}}" class="muted spaced">保存后等待负责人本人确认就绪；编辑会清除此前的就绪状态，历史保留。</view>
        <view wx:if="{{editor === 'import'}}" class="muted spaced">来自第 {{revision}} 版纪要，确认后新建待开始任务。不会覆盖已有任务，也不会代替负责人提交或验收。修订纪要后如行动内容重复，请先核对现有任务。</view>
      </block>
      <block wx:elif="{{editor === 'minutes'}}"><view class="card-title">记录新一版纪要</view><view class="notice">这是发起人记录，不代表全员同意。保存后保留旧版，已转入的任务不会随修订改变。</view>
        <view class="field-label">会议日期</view><picker mode="date" value="{{meetingDate}}" start="{{view.dateFrom}}" end="{{view.dateTo}}" data-field="meetingDate" bindchange="field" disabled="{{busy}}"><view class="field">{{meetingDate}} ▾</view></picker>
        <view class="field-label">会议摘要（必填）</view><textarea class="field work-area minutes-summary" value="{{summary}}" maxlength="1500" data-field="summary" bindinput="field" disabled="{{busy}}" />
        <view class="field-label">决议记录（选填）</view><textarea class="field work-area minutes-decisions" value="{{decisions}}" maxlength="1000" data-field="decisions" bindinput="field" disabled="{{busy}}" />
        <view class="field-label">后续行动（每行一项，最多 10 项，共 1000 字）</view><textarea class="field work-area minutes-steps" value="{{nextSteps}}" maxlength="1000" data-field="nextSteps" bindinput="field" disabled="{{busy}}" />
      </block>
      <block wx:else><view class="card-title">{{actionLabel}}</view><view class="field-label">{{action === 'start' ? '说明（可选）' : '完成情况、验收依据或重开原因（必填）'}}</view><textarea class="field work-area shared-note" value="{{note}}" maxlength="300" data-field="note" bindinput="field" disabled="{{busy}}" /></block>
      <button class="primary save-shared" bindtap="save" disabled="{{busy || loading || !fresh}}" loading="{{busy}}">确认记录</button><button class="secondary cancel-shared" bindtap="cancel" disabled="{{busy}}">取消</button>
    </view>
    <block wx:if="{{tab === 'preparation'}}">
      <view class="muted spaced">当前成员已确认就绪 {{readyCount}} / {{view.preparation.length}} 项。负责人退出后，需重新分派并确认。</view>
      <view class="empty" wx:if="{{!view.preparation.length}}">还没有会前准备事项。</view>
      <view class="card" wx:for="{{view.preparation}}" wx:key="id"><view class="task-title">{{item.title}}</view><view class="badge spaced">{{!item.assignee.active ? '待重新分派' : item.done ? '本人已确认就绪' : '待负责人确认'}}</view><view class="muted spaced">{{item.assignee.name}}{{item.assignee.isMe ? '（我）' : ''}} · 截止 {{item.dueDate}}</view><view class="record">{{item.details}}</view>
        <block wx:if="{{!editor}}"><button wx:if="{{item.canEdit}}" class="secondary edit-preparation" data-id="{{item.id}}" bindtap="editPreparation" disabled="{{!fresh || busy}}">编辑／重新分派</button><button wx:if="{{item.canToggle}}" class="secondary toggle-preparation" data-id="{{item.id}}" bindtap="togglePreparation" disabled="{{!fresh || busy}}">{{item.done ? '撤回就绪' : '本人确认就绪'}}</button></block>
        <view wx:for="{{item.history}}" wx:for-item="entry" wx:key="index" class="record"><view class="muted">{{entry.actor}} · {{entry.label}}</view><view class="muted">{{entry.note}}</view></view>
      </view>
    </block>
    <block wx:if="{{tab === 'minutes'}}">
      <view class="notice">纪要由发起人记录和修订，所有当前成员可查阅历史。决议文字不代表成员已逐人确认。只有最新版后续行动可以转入任务。</view>
      <view class="empty" wx:if="{{!view.minutes.length}}">还没有会议纪要。</view>
      <view class="card" wx:for="{{view.minutes}}" wx:key="revision"><view class="task-title">第 {{item.revision}} 版 · {{item.date}}</view><view class="muted spaced">{{item.actor}} 记录 · {{item.at}}</view><view class="record">{{item.summary}}</view><view class="field-label">决议记录</view><view class="record">{{item.decisions || '未填写'}}</view><view class="field-label">后续行动</view>
        <view wx:for="{{item.nextSteps}}" wx:for-item="step" wx:key="index" class="record"><view>{{step.index + 1}}. {{step.text}}</view><view wx:if="{{step.taskId}}" class="muted">已转入协作任务</view><button wx:if="{{step.canImport && !editor}}" class="secondary import-action" data-revision="{{item.revision}}" data-index="{{step.index}}" bindtap="previewAction" disabled="{{!fresh || busy}}">预览并分派任务</button></view>
      </view>
    </block>
    <block wx:if="{{tab === 'tasks'}}">
    <view class="empty" wx:if="{{!view.tasks.length}}">还没有协作任务，发起人可先分派一项。</view>
    <view class="card" wx:for="{{view.tasks}}" wx:key="id"><view class="task-title">{{item.title}}</view><view class="spaced"><text class="badge">{{item.stateLabel}}</text></view><view class="muted spaced">负责人 {{item.assignee.name}}{{item.assignee.isMe ? '（我）' : ''}}{{!item.assignee.active ? '（已退出，待重新分派）' : ''}} · 截止 {{item.dueDate}}</view><view class="subtitle spaced">{{item.details}}</view>
      <block wx:if="{{!editor}}"><button wx:if="{{item.canEdit}}" class="secondary edit-shared" data-id="{{item.id}}" bindtap="edit" disabled="{{!fresh || busy}}">编辑／重新分派</button><button wx:if="{{item.canStart}}" class="secondary" data-id="{{item.id}}" data-action="start" bindtap="act" disabled="{{!fresh || busy}}">开始执行</button><button wx:if="{{item.canSubmit}}" class="secondary" data-id="{{item.id}}" data-action="submit" bindtap="act" disabled="{{!fresh || busy}}">提交完成说明</button><button wx:if="{{item.canVote}}" class="secondary" data-id="{{item.id}}" data-action="accept" bindtap="act" disabled="{{!fresh || busy}}">我确认验收</button><button wx:if="{{item.canVote}}" class="secondary" data-id="{{item.id}}" data-action="dispute" bindtap="act" disabled="{{!fresh || busy}}">我有验收异议</button><button wx:if="{{item.canReopen}}" class="secondary" data-id="{{item.id}}" data-action="reopen" bindtap="act" disabled="{{!fresh || busy}}">重新打开</button></block>
      <view wx:for="{{item.votes}}" wx:for-item="vote" wx:key="memberId" class="record"><view>{{vote.name}}{{vote.isMe ? '（我）' : ''}} · {{vote.decision === 'ACCEPT' ? '已确认' : vote.decision === 'DISPUTE' ? '有异议' : '待确认'}}{{!vote.active ? '（已退出，需重开）' : ''}}</view><view class="muted">{{vote.note}}</view></view>
      <view wx:for="{{item.history}}" wx:for-item="entry" wx:key="index" class="record"><view class="muted">{{entry.actor}} · {{entry.label}}</view><view class="muted">{{entry.note}}</view></view>
    </view>
    </block>
  </block>
</view>

.work-area { width: 100%; height: 170rpx; line-height: 1.6; }
.task-title { font-size: 32rpx; font-weight: 600; word-break: break-all; }
.record { word-break: break-all; }
.work-tabs { display: flex; gap: 10rpx; margin: 20rpx 0; }
.work-tabs button { flex: 1; font-size: 24rpx; padding: 0 8rpx; }
.record { white-space: pre-wrap; }
